<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup> 
		
	<supportedRuntime version="v2.0.50727"/></startup>
	<!--
		SqlRunnerExePath and CorpusDataRootPath are machine-specific (dev-only
		tool/data paths) and must NOT be committed with real values. The actual
		values live in SqlRunner.local.config, which is git-ignored; see
		SqlRunner.local.config.example for the expected format/keys. If that file
		is missing, both settings fall back to string.Empty and any test mode
		that needs them will report "not found" and skip/abort gracefully.
	-->
	<appSettings file="SqlRunner.local.config">
		<add key="SqlRunnerExePath" value=""/>
		<add key="CorpusDataRootPath" value=""/>
	</appSettings>
	<connectionStrings>
		<add name="Test" connectionString="Data Source=.;Initial Catalog=Data;"/>
	</connectionStrings>
</configuration>
